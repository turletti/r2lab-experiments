{# OCUDU components: the upstream values, unchanged (the CSI logger environment comes from extra_env_vars), with #}
{# the O-RAN 7.2 fronthaul resources of a gNB or DU on a Benetel RU, read by the nador ocudu-gnb and ocudu-du charts. #}
{# The OCUDU metrics are collected by the ocudu-metrics chart (metrics.ran.ran_kpis), not by a sidecar. #}
{% include 'ran/ocudu/ocudu-' ~ component.type ~ '/values.yaml.j2' %}

# O-RAN 7.2 fronthaul (radio fhi72): SR-IOV VFs of the node (U-plane VF, then C-plane VF) and 1G hugepages of the
# Guaranteed pod, from the deployment model miscellaneous field (r2lab_experiments.fhi72.fhi72_miscellaneous)
{% if miscellaneous is defined and component.node_name in (miscellaneous or {}).get('derived_fhi72_params', {}) %}
fhi72:
  sriovResources:
{% for resource in miscellaneous.derived_fhi72_params[component.node_name].sriov_resources %}
    - {{ resource }}
{% endfor %}
  pciDeviceEnvVars:
{% for env_var in miscellaneous.derived_fhi72_params[component.node_name].pci_device_env_vars %}
    - {{ env_var }}
{% endfor %}
  hugepages1Gi: {{ miscellaneous.du_resources.limits.nf.hugepages_1gi }}
{% else %}
fhi72: null
{% endif %}
